    {
      "name": "03. Public Registration & Role Tampering Defense",
      "item": [
        {
          "name": "Public Registration (Role Escalation Attempt Ignored)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Role Hacker\",\n  \"email\": \"role_hacker_test@campuspro.com\",\n  \"password\": \"password123\",\n  \"role\": \"ADMIN\",\n  \"dateOfBirth\": \"2002-01-01\",\n  \"studentMobileNumber\": \"9876543210\",\n  \"parentMobileNumber\": \"9876543211\",\n  \"permanentAddress\": \"123 Security Blvd\",\n  \"permanentPinCode\": \"110001\",\n  \"temporaryAddress\": \"123 Security Blvd\",\n  \"temporaryPinCode\": \"110001\",\n  \"enrollmentNo\": \"HACKER999\",\n  \"department\": \"{{departmentId}}\",\n  \"section\": \"{{sectionId}}\",\n  \"cgpa\": 8,\n  \"tenthPercentage\": 80,\n  \"twelfthPercentage\": 80,\n  \"backlogs\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created or 409 Conflict', function () { pm.expect([201, 409]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Assigned role is strictly STUDENT', function () { pm.expect(json.user.role).to.eql('STUDENT'); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
