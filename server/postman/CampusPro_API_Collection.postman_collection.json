  "item": [
    {
      "name": "01. System & Health Diagnostics",
      "item": [
        {
          "name": "Health Check (Safe Diagnostics)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status is healthy', function () { const json = pm.response.json(); pm.expect(json.status).to.eql('healthy'); });",
                  "pm.test('No secrets leaked', function () { const raw = pm.response.text(); pm.expect(raw).to.not.include('secret').and.to.not.include('password'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unmatched Route (Standardized 404 Handler)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/non-existent-resource-endpoint",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "non-existent-resource-endpoint"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404 Not Found', function () { pm.response.to.have.status(404); });",
                  "pm.test('Standard error payload', function () { const json = pm.response.json(); pm.expect(json.success).to.be.false; pm.expect(json.code).to.eql('NOT_FOUND'); });"
                ]
              }
            }
          ]
        }
      ]
    },
