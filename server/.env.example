PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/campuspro
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_MAX_IDLE_TIME_MS=30000

JWT_SECRET=CHANGE_ME_IN_PRODUCTION

NODE_ENV=development

CLIENT_URL=http://localhost:3000
TRUST_PROXY=1

# Rate Limiting Configuration
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# Worker Concurrency Configuration
EMAIL_WORKER_CONCURRENCY=5
NOTIFICATION_WORKER_CONCURRENCY=10
EXPORT_WORKER_CONCURRENCY=2

# Email / SMTP Configuration
# Set EMAIL_ENABLED=true in production to enable outbound transactional emails.
# If false, emails are safely skipped and logged without blocking workflows.
EMAIL_ENABLED=false

# SMTP Provider Settings
# For STARTTLS on Port 587: set SMTP_SECURE=false
# For SSL/TLS on Port 465:  set SMTP_SECURE=true
# (Supported providers: Institutional SMTP relay, Gmail with App Password, SendGrid, Amazon SES, Postmark)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication (Never commit real credentials)
# Note: SMTP_PASS and SMTP_PASSWORD are both supported.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_PASS=

# Sender Identity Configuration
# Note: SMTP_FROM and SMTP_FROM_EMAIL are both supported.
SMTP_FROM_NAME="CampusPro Training & Placement"
SMTP_FROM_EMAIL=tpo@yourcollege-domain.com
# SMTP_FROM=tpo@yourcollege-domain.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
