# CampusPro Client Environment Variables
# In production, specify the backend API URL if not using a reverse proxy (e.g., https://api.campuspro.example.com/api)
# In development, leave blank or set to /api to use the Vite proxy to http://localhost:5000
VITE_API_BASE_URL=/api

# Optional Google Analytics 4 Measurement ID (leave blank or omitted if analytics is not configured)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
